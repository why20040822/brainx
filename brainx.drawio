        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n  subgraph ENTRY[\&quot;入口层\&quot;]\n    direction LR\n    SV[\&quot;server.js&lt;br/&gt;HTTP+SSE+静态 · main\&quot;]\n    MC[\&quot;mcp/server.mjs&lt;br/&gt;MCP stdio · 10工具\&quot;]\n    CLI[\&quot;bin/*.mjs&lt;br/&gt;CLI\&quot;]\n  end\n\n  subgraph DOMAIN[\&quot;领域层\&quot;]\n    direction TB\n    BR[\&quot;bridge.js&lt;br/&gt;飞书桥接·轮询\&quot;]\n    SY[\&quot;sync.js&lt;br/&gt;同步+校验\&quot;]\n    RM[\&quot;recommend.js&lt;br/&gt;生成+冻结\&quot;]\n    SC[\&quot;scorer.js&lt;br/&gt;六维评分\&quot;]\n    EG[\&quot;engagement.js&lt;br/&gt;状态机\&quot;]\n    RP[\&quot;replay.js&lt;br/&gt;回放+结果\&quot;]\n    AP[\&quot;autopush.js&lt;br/&gt;变化检测\&quot;]\n    PU[\&quot;push.js&lt;br/&gt;推卡\&quot;]\n  end\n\n  subgraph AUTH[\&quot;凭据身份层\&quot;]\n    direction TB\n    OA[\&quot;oauth.js&lt;br/&gt;网页授权\&quot;]\n    FS[\&quot;feishu.js&lt;br/&gt;令牌+直连API\&quot;]\n    RS[\&quot;roster.js&lt;br/&gt;花名册\&quot;]\n    VZ[\&quot;visibility.js&lt;br/&gt;可见性\&quot;]\n  end\n\n  subgraph INFRA[\&quot;基础设施层\&quot;]\n    direction TB\n    DB[\&quot;db.js&lt;br/&gt;SQLite+迁移\&quot;]\n    SE[\&quot;session.js&lt;br/&gt;HMAC Cookie\&quot;]\n    EN[\&quot;env.js&lt;br/&gt;.env\&quot;]\n  end\n\n  subgraph EXT[\&quot;🌐 现有外部接口\&quot;]\n    direction TB\n    FEISHU[\&quot;飞书 OpenAPI&lt;br/&gt;authorize/app_token/oidc/&lt;br/&gt;refresh/chats/messages/bitable\&quot;]\n    LARK[\&quot;lark-cli 子进程&lt;br/&gt;Bitable回落 · 发卡 · roster刷新\&quot;]\n    SQLITEDB[(\&quot;SQLite 文件&lt;br/&gt;data/brainx.db\&quot;)]\n    FILES[\&quot;本地文件&lt;br/&gt;.env / .secret /&lt;br/&gt;fixtures / migrations\&quot;]\n  end\n\n  subgraph FUT[\&quot;🔌 待接入外部接口（你后面要加的）\&quot;]\n    direction TB\n    ATS[\&quot;ATS 职位源&lt;br/&gt;替换 Bitable payload\&quot;]\n    IM[\&quot;其他 IM 消息源&lt;br/&gt;替换 listChatMessages\&quot;]\n    IDP[\&quot;其他身份源 IdP&lt;br/&gt;替换 exchangeCode\&quot;]\n    PUSH2[\&quot;其他推送通道&lt;br/&gt;替换发卡\&quot;]\n    RDS[\&quot;外部数据库&lt;br/&gt;MySQL/RDS 镜像或查询\&quot;]\n    REL[\&quot;关系/策展源&lt;br/&gt;写 job_memberships\&quot;]\n    OUT2[\&quot;外部结果回填&lt;br/&gt;写 job_outcomes\&quot;]\n  end\n\n  %% ===== 入口 → 领域/凭据/基建（server 是枢纽，调用最广）=====\n  SV --&gt; BR &amp; SY &amp; RM &amp; EG &amp; RP &amp; PU &amp; AP &amp; OA &amp; FS &amp; RS &amp; VZ &amp; SE &amp; DB &amp; EN\n  MC --&gt; SY &amp; RM &amp; EG &amp; RP &amp; PU &amp; VZ &amp; DB &amp; EN\n  CLI --&gt; SY &amp; RM &amp; PU &amp; RS &amp; DB\n\n  %% ===== 领域层内部调用 =====\n  BR --&gt;|runSync| SY\n  BR --&gt;|getValidAccessToken/listChats/listMessages/listBitable| FS\n  RM --&gt;|latestCompleteSnapshot| SY\n  RM --&gt;|scoreJob/explain| SC\n  RM --&gt;|listConsultants| RS\n  AP --&gt;|pushCard| PU\n  AP --&gt;|loadConsultants| RM\n  SY --&gt; DB\n  EG --&gt; DB\n  RP --&gt; DB\n  PU --&gt; DB\n  BR --&gt; DB\n\n  %% ===== 凭据身份层调用 =====\n  OA --&gt;|sessionSecret| SE\n  FS --&gt;|sessionSecret| SE\n  FS --&gt;|appAccessToken| OA\n  RS --&gt;|now| DB\n  DB --&gt;|seedRoster| RS\n\n  %% ===== 现有外部接口调用（蓝虚线）=====\n  OA -.-&gt; FEISHU\n  FS -.-&gt; FEISHU\n  BR -.-&gt; LARK\n  SY -.-&gt; LARK\n  PU -.-&gt; LARK\n  DB -.-&gt; SQLITEDB\n  DB -.-&gt; FILES\n  SE -.-&gt; FILES\n  EN -.-&gt; FILES\n  SY -.-&gt; FILES\n  RS -.-&gt; FILES\n\n  %% ===== 待接入（黄虚线，标注接入点）=====\n  SY -. \&quot;① payload 接入\&quot; .-&gt; ATS\n  SY -. \&quot;② relation 注入\&quot; .-&gt; REL\n  FS -. \&quot;③ 消息拉取接入\&quot; .-&gt; IM\n  OA -. \&quot;④ code-&gt;身份接入\&quot; .-&gt; IDP\n  PU -. \&quot;⑤ 发卡接入\&quot; .-&gt; PUSH2\n  DB -. \&quot;⑥ 镜像/查询接入\&quot; .-&gt; RDS\n  RP -. \&quot;⑦ 结果回填接入\&quot; .-&gt; OUT2\n\n  classDef future fill:#fff3cd,stroke:#d4a017,stroke-dasharray:5 5,color:#7a5c00;\n  classDef ext fill:#e7f3ff,stroke:#3b82f6,color:#1e3a5f;\n  class ATS,IM,IDP,PUSH2,RDS,REL,OUT2 future;\n  class FEISHU,LARK,SQLITEDB,FILES ext;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ezWwS2NKnAK2YW0ShYP4-1">
