{
  "name": "brainx-local",
  "version": "1.0.0",
  "description": "Brain X 职位决策工作台（本地版）：SQLite + node:http + 零依赖前端",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "mysql2": "^3.23.3"
  },
  "scripts": {
    "dev": "node src/server.js",
    "dev:frontend-only": "cd frontend/btex-frontend && WRANGLER_LOG_PATH=.wrangler/wrangler.log ./node_modules/.bin/vinext dev --host 0.0.0.0 --port 3000",
    "build": "cd frontend/btex-frontend && WRANGLER_LOG_PATH=.wrangler/wrangler.log ./node_modules/.bin/vinext build",
    "start": "node src/server.js",
    "start:frontend-only": "cd frontend/btex-frontend && WRANGLER_LOG_PATH=.wrangler/wrangler.log ./node_modules/.bin/vinext start --host 0.0.0.0 --port 3000",
    "frontend:install": "npm --prefix frontend/btex-frontend install",
    "sync": "node bin/brainx-sync.mjs",
    "adapter": "node bin/brainx-adapter.mjs",
    "recommend": "node bin/brainx-recommend.mjs",
    "replay": "node bin/brainx-replay.mjs",
    "push": "node bin/brainx-push.mjs",
    "web": "node src/server.js",
    "fixture": "node scripts/build_fixture.mjs",
    "init-talent": "node scripts/init-talent-schema.mjs",
    "talent:health": "node scripts/talent-health.mjs",
    "test": "node --test --test-force-exit"
  },
  "bin": {
    "braintex-local-sync": "bin/brainx-sync.mjs",
    "braintex-local-adapter": "bin/brainx-adapter.mjs",
    "braintex-local-recommend": "bin/brainx-recommend.mjs",
    "braintex-local-replay": "bin/brainx-replay.mjs",
    "braintex-local-push": "bin/brainx-push.mjs",
    "braintex-local-web": "bin/brainx-web.mjs"
  }
}
